[agent]
id = "default"
system_prompt = "You are Turin's bug triage operator."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"

[kernel]
workspace_root = "."
max_turns = 50
heartbeat_interval_seconds = 30
initial_spawn_depth = 0

[persistence.state]
path = ".turin/state.db"

[harness]
directory = ".turin/harnesses"

[providers.anthropic]
type = "anthropic"
api_key_env = "ANTHROPIC_API_KEY"

[agents.triager]
id = "triager"
system_prompt = "You are a bug triager."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"
harness_dir = ".turin/harnesses-triager"

[agents.responder]
id = "responder"
system_prompt = "You are an issue response specialist."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"
harness_dir = ".turin/harnesses-responder"
