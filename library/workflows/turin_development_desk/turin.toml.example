[agent]
id = "default"
system_prompt = "You are Turin's repository-aware development partner."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"

[kernel]
workspace_root = "."
max_turns = 80
heartbeat_interval_seconds = 30
initial_spawn_depth = 0

[persistence.state]
path = ".turin/state.db"

[harness]
directory = "library/workflows/turin_development_desk/harness"

[providers.anthropic]
type = "anthropic"
api_key_env = "ANTHROPIC_API_KEY"

[agents.planner]
id = "planner"
system_prompt = "You are a pragmatic coding plan specialist."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"
harness = "planner"

[agents.reviewer]
id = "reviewer"
system_prompt = "You are a strict senior code reviewer."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"
harness = "reviewer"

[harnesses.planner]
directory = "library/workflows/turin_development_desk/agents/planner"

[harnesses.reviewer]
directory = "library/workflows/turin_development_desk/agents/reviewer"
