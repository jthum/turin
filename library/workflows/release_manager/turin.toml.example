[agent]
id = "default"
system_prompt = "You are Turin's release manager."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"

[kernel]
workspace_root = "."
max_turns = 50
heartbeat_interval_secs = 30
initial_spawn_depth = 0

[persistence.state]
path = ".turin/state.db"

[harness]
directory = ".turin/harnesses"

[providers.anthropic]
type = "anthropic"
api_key_env = "ANTHROPIC_API_KEY"

[agents.readiness_reviewer]
id = "readiness_reviewer"
system_prompt = "You are a release readiness reviewer."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"
harness_dir = ".turin/harnesses-readiness"

[agents.changelog_writer]
id = "changelog_writer"
system_prompt = "You are a changelog writer."
model = "claude-sonnet-4-20250514"
provider = "anthropic"
mode = "auto"
harness_dir = ".turin/harnesses-changelog"
